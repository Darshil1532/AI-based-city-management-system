{
  "entities": {
    "complaint": {
      "title": "Municipal Complaint",
      "description": "Civic complaints filed by citizens and tracked by municipal authorities",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "citizenId": { "type": "string" },
        "citizenName": { "type": "string" },
        "citizenPhone": { "type": "string" },
        "citizenEmail": { "type": "string" },
        "category": { "type": "string" },
        "department": { "type": "string" },
        "severity": { "type": "string" },
        "status": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "assignedOfficer": { "type": "string" }
      },
      "required": ["id", "category", "severity", "status", "title", "description", "createdAt"]
    },
    "insight": {
      "title": "AI Insight",
      "description": "Cross-issue systemic municipal intelligence and proactive recommendations",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "detectedPattern": { "type": "string" },
        "recommendation": { "type": "string" },
        "suggestedDepartment": { "type": "string" },
        "priority": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "title", "detectedPattern", "recommendation", "status"]
    },
    "notification": {
      "title": "Civic Notification",
      "description": "System alerts and dispatch updates for municipal residents and administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" },
        "type": { "type": "string" }
      },
      "required": ["id", "userId", "title", "message", "timestamp", "read", "type"]
    },
    "hotspot": {
      "title": "Municipal Geographic Hotspot",
      "description": "Clustered civic issues identifying geographic infrastructure bottlenecks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "count": { "type": "number" },
        "severity": { "type": "string" },
        "location": { "type": "string" },
        "coordinates": { "type": "object" }
      },
      "required": ["id", "category", "count", "severity", "location"]
    },
    "admin": {
      "title": "Municipal Administrator Role",
      "description": "Authorized municipal officer credentials and RBAC clearance",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    }
  },
  "firestore": {
    "/complaints/{complaintId}": {
      "schema": "complaint",
      "description": "Civic complaint records filed by citizens and resolved by city departments"
    },
    "/insights/{insightId}": {
      "schema": "insight",
      "description": "Systemic intelligence patterns and root-cause hypotheses"
    },
    "/notifications/{notificationId}": {
      "schema": "notification",
      "description": "Civic notifications for municipal users"
    },
    "/hotspots/{hotspotId}": {
      "schema": "hotspot",
      "description": "Geographic issue clusters across municipal sectors"
    },
    "/admins/{adminUid}": {
      "schema": "admin",
      "description": "Authorized municipal administration accounts"
    }
  }
}
